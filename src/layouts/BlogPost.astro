---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, tags = [] } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
			.hero-image {
				width: 1020px;
				max-width: calc(100% - 2rem);
				margin: 2rem auto 0;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 3rem 0;
				color: rgb(var(--gray-dark));
			}
			.article-header {
				margin-bottom: 2.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.article-header h1 {
				margin-bottom: 0.75rem;
				font-size: 2.7rem;
			}
			.article-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				align-items: center;
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.category {
				color: var(--accent-dark);
				font-weight: 700;
			}
			.last-updated-on {
				margin: 0.4rem 0 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem;
				margin-top: 0.9rem;
			}
			.tag {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.article-content {
				line-height: 1.85;
			}
			.article-content :global(h2) {
				margin-top: 2.5rem;
			}
			.article-content :global(h3) {
				margin-top: 2rem;
			}
			.article-content :global(p) {
				margin: 0 0 1.35rem;
			}
			.article-content :global(pre) {
				box-sizing: border-box;
				max-width: 100%;
				overflow-x: auto;
			}
			.article-content :global(img) {
				display: block;
				max-width: 100%;
				height: auto;
				margin: 1.5rem auto;
			}
			.article-content :global(table) {
				display: block;
				max-width: 100%;
				overflow-x: auto;
				border-collapse: collapse;
			}
			.article-content :global(blockquote) {
				font-size: 1rem;
			}
			@media (max-width: 720px) {
				.prose {
					padding: 2rem 0;
				}
				.article-header {
					margin-bottom: 2rem;
				}
				.article-header h1 {
					font-size: 2.1rem;
				}
				.article-content :global(pre) {
					padding: 1rem;
					font-size: 0.9rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<header class="article-header">
						<h1>{title}</h1>
						<p class="article-meta">
							<FormattedDate date={pubDate} />
							<span aria-hidden="true">·</span>
							<span>分类：<span class="category">{category}</span></span>
						</p>
						{updatedDate && (
							<p class="last-updated-on">
								最后更新：<FormattedDate date={updatedDate} />
							</p>
						)}
						{tags.length > 0 && (
							<div class="tags" aria-label="文章标签">
								{tags.map((tag) => <span class="tag">#{tag}</span>)}
							</div>
						)}
					</header>
					<div class="article-content">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
