---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { projects } from '../data/projects';

const featuredProjects = projects.slice(0, 3);
const recentPosts = (
	await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)
)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.home-section {
				margin-top: 3rem;
				padding-top: 2.5rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.project-list,
			.recent-posts ul {
				margin: 1.25rem 0 0;
				padding: 0;
				list-style: none;
			}
			.project-list {
				display: grid;
				gap: 1rem;
			}
			.project-card {
				padding: 1rem 1.1rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				background: rgba(255, 255, 255, 0.65);
			}
			.project-card h3,
			.recent-posts h3 {
				margin-bottom: 0.25rem;
				font-size: 1.25rem;
			}
			.project-card p {
				margin: 0.35rem 0;
			}
			.technologies {
				color: rgb(var(--gray));
				font-size: 0.88rem;
			}
			.recent-posts li {
				margin-bottom: 1.25rem;
			}
			.recent-posts h3 a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.recent-posts h3 a:hover {
				color: var(--accent);
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.category {
				color: var(--accent-dark);
				font-weight: 700;
			}
			.section-link {
				margin-top: 1.5rem;
			}
			@media (max-width: 720px) {
				.home-section {
					margin-top: 2rem;
					padding-top: 2rem;
				}
				.project-card {
					padding: 0.9rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>你好，我是琉璃</h1>

			<p>这里是我的个人技术博客，主要用于记录学习过程、项目实践和技术总结。</p>

			<p>目前主要关注 C++、Linux、网络编程、服务器开发以及相关工程实践。</p>

			<h2>我正在学习和实践的内容</h2>

			<ul>
				<li>C++ 与现代 C++</li>
				<li>Linux 系统编程</li>
				<li>TCP/IP 与网络编程</li>
				<li>高并发服务器与 Reactor 模型</li>
				<li>多线程与线程池</li>
				<li>项目开发与工程实践</li>
			</ul>

			<section class="home-section">
				<h2>项目实践</h2>
				<ul class="project-list">
					{
						featuredProjects.map((project) => (
							<li class="project-card">
								<h3>{project.name}</h3>
								<p>{project.summary}</p>
								<p class="technologies">{project.technologies.join(' · ')}</p>
							</li>
						))
					}
				</ul>
				<p class="section-link">
					<a href="/projects/">查看全部项目 →</a>
				</p>
			</section>

			<section class="home-section recent-posts">
				<h2>最近文章</h2>
				<ul>
					{
						recentPosts.map((post) => (
							<li>
								<h3>
									<a href={`/blog/${post.data.slug}/`}>{post.data.title}</a>
								</h3>
								<p class="post-meta">
									<FormattedDate date={post.data.pubDate} />
									<span aria-hidden="true">·</span>
									<span class="category">{post.data.category}</span>
								</p>
							</li>
						))
					}
				</ul>
				<p class="section-link">
					<a href="/blog/">查看全部文章 →</a>
				</p>
			</section>

			<section class="home-section">
				<h2>关于这个博客</h2>
				<p>
					这个博客主要用于记录我的学习过程。相比单纯记录结论，我希望尽可能保留学习过程中遇到的问题、
					解决方法、实现思路以及自己的理解。
				</p>
				<p>博客内容会随着我的学习和项目开发持续更新。</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
